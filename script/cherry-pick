#!/usr/bin/env bash

set -euo pipefail

if ((BASH_VERSINFO[0] < 5 || BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 2)); then
  echo "Bash 5.2 or later is required" >&2
  exit 1
fi

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  if [[ $# -ne 1 ]]; then
    echo "Unexpected argument: $2" >&2
    echo "Run ./script/cherry-pick --help" >&2
    exit 1
  fi
  echo "Cherry-pick a commit to a release branch and create a pull request."
  echo
  echo "Usage: ./script/cherry-pick [OPTIONS] <branch> <commit-sha> <beta|stable>"
  echo
  echo "Options:"
  echo "  --continue  Continue after resolving conflicts."
  echo "  -h, --help  Show help."
  exit 0
fi

should_continue=false
if [[ ${1:-} == "--continue" ]]; then
  should_continue=true
  shift
fi

if [[ $# -eq 0 ]]; then
  echo "Missing release branch" >&2
  echo "Run ./script/cherry-pick --help" >&2
  exit 1
fi
if [[ $# -eq 1 ]]; then
  echo "Missing commit SHA" >&2
  echo "Run ./script/cherry-pick --help" >&2
  exit 1
fi
if [[ $# -eq 2 ]]; then
  echo "Missing release channel" >&2
  echo "Run ./script/cherry-pick --help" >&2
  exit 1
fi
if [[ $# -gt 3 ]]; then
  echo "Unexpected argument: $4" >&2
  echo "Run ./script/cherry-pick --help" >&2
  exit 1
fi

target_branch="$1"
commit_sha="$2"
channel="$3"

if [[ ! "$target_branch" =~ ^[0-9]{2}\.[0-9]+\.x$ ]]; then
  echo "Invalid release branch: $target_branch" >&2
  echo "Run ./script/cherry-pick --help" >&2
  exit 1
fi

case "$channel" in
beta | stable)
  ;;
*)
  echo "Unsupported release channel: $channel" >&2
  echo "Run ./script/cherry-pick --help" >&2
  exit 1
  ;;
esac

for cmd in git gh; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Missing required command: $cmd" >&2
    exit 1
  fi
done

if ! gh auth status --active --hostname github.com >/dev/null 2>&1; then
  echo "GitHub CLI authentication is required" >&2
  exit 1
fi

if ! $should_continue; then
  fetch_args=()
  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    fetch_args=(--depth 2)
  fi
  git fetch "${fetch_args[@]}" origin "$commit_sha" "$target_branch" >&2
fi
short_sha=$(git rev-parse --short "$commit_sha")
cherry_pick_branch="cherry-pick-${target_branch}-${short_sha}"

if $should_continue; then
  branch=$(git branch --show-current)
  if [[ "$branch" != "$cherry_pick_branch" ]]; then
    echo "Cherry-pick must continue from $cherry_pick_branch: ${branch:-detached HEAD}" >&2
    exit 1
  fi
  if ! pending_commit_sha=$(git rev-parse --verify --quiet CHERRY_PICK_HEAD); then
    echo "No cherry-pick is in progress" >&2
    exit 1
  fi
  if [[ "$pending_commit_sha" != "$commit_sha" ]]; then
    echo "Pending cherry-pick does not match $short_sha" >&2
    exit 1
  fi

  cherry_pick_args=(--continue)
else
  pull_request_url=$(gh pr list --base "$target_branch" --head "$cherry_pick_branch" --state open --json isCrossRepository,url --jq '[.[] | select(.isCrossRepository == false)][0].url // empty')
  if [[ -n "$pull_request_url" ]]; then
    echo "$pull_request_url"
    exit 0
  fi
  cherry_pick_args=("$commit_sha")
fi

if ! remote_branch=$(git ls-remote --branches origin "refs/heads/${cherry_pick_branch}"); then
  echo "Could not inspect origin branch: $cherry_pick_branch" >&2
  exit 1
fi
if [[ -n "$remote_branch" ]]; then
  echo "Cherry-pick branch already exists on origin: $cherry_pick_branch" >&2
  exit 1
fi

if ! $should_continue; then
  git switch --create "$cherry_pick_branch" "origin/$target_branch" >&2
fi
if ! GIT_EDITOR=true git cherry-pick "${cherry_pick_args[@]}" >&2; then
  conflicted_files=$(git diff --name-only --diff-filter=U)
  if [[ -n "$conflicted_files" ]]; then
    echo "Resolve conflicts and stage the files before continuing" >&2
    echo "Run ./script/cherry-pick --continue $target_branch $commit_sha $channel" >&2
    echo "Run git cherry-pick --abort to cancel" >&2
  fi
  exit 1
fi
git push origin "$cherry_pick_branch" >&2

pull_request_title=$(git log -1 --format=%s "$commit_sha")
pull_request_body=$(git log -1 --format=%b "$commit_sha")

if [[ "$pull_request_title" =~ \(#([0-9]+)\)$ ]]; then
  source_reference="#${BASH_REMATCH[1]}"
else
  source_reference="$commit_sha"
fi
if [[ -n "$pull_request_body" ]]; then
  pull_request_body+=$'\n\n'
fi
pull_request_body+="Cherry-picked from ${source_reference}"

pull_request_url=$(gh pr create --base "$target_branch" --head "$cherry_pick_branch" --title "$pull_request_title (cherry-pick to $channel)" --body "$pull_request_body")

echo "$pull_request_url"
