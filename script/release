#!/usr/bin/env bash

set -euo pipefail

if ((BASH_VERSINFO[0] < 5 || BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 2)); then
  echo "Bash 5.2 or later is required" >&2
  exit 1
fi

if [[ ${1:-} == "-h" || ${1:-} == "--help" ]]; then
  if [[ $# -ne 1 ]]; then
    echo "Unexpected argument: $2" >&2
    echo "Run ./script/release --help" >&2
    exit 1
  fi
  echo "Create a Zaku release branch and advance main."
  echo
  echo "Usage: ./script/release <beta|stable> [--bump-year]"
  echo
  echo "Options:"
  echo "  --bump-year  Bump to the next year before releasing."
  echo "  -h, --help   Show help."
  exit 0
fi

if [[ $# -eq 0 ]]; then
  echo "Missing release channel" >&2
  echo "Run ./script/release --help" >&2
  exit 1
fi

channel="$1"
shift
case "$channel" in
beta | stable)
  ;;
*)
  echo "Unsupported release channel: $channel" >&2
  echo "Run ./script/release --help" >&2
  exit 1
  ;;
esac

bump_year=false
if [[ ${1:-} == "--bump-year" ]]; then
  bump_year=true
  shift
fi
if [[ $# -gt 0 ]]; then
  echo "Unexpected argument: $1" >&2
  echo "Run ./script/release --help" >&2
  exit 1
fi

for cmd in cargo gh git; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "Missing required command: $cmd" >&2
    exit 1
  fi
done
if ! gh auth status --active --hostname github.com >/dev/null 2>&1; then
  echo "GitHub CLI authentication is required" >&2
  exit 1
fi

branch=$(git branch --show-current)
if [[ "$branch" != "main" ]]; then
  echo "Releases must run from main: ${branch:-detached HEAD}" >&2
  exit 1
fi
if [[ -n "$(git status --porcelain)" ]]; then
  echo "Working tree must be clean before releasing Zaku" >&2
  exit 1
fi
if ! remote_main_sha=$(git ls-remote --exit-code origin refs/heads/main | cut -f1); then
  echo "Could not resolve origin/main" >&2
  exit 1
fi
local_sha=$(git rev-parse HEAD)
if [[ "$local_sha" != "$remote_main_sha" ]]; then
  echo "Local main must match origin/main before releasing Zaku" >&2
  exit 1
fi

source_version=$(cargo app-version show)
if $bump_year; then
  source_version=$(cargo app-version bump "$source_version" year)
fi
release_version=$(cargo app-version promote "$source_version" "$channel")
main_version=$(cargo app-version bump "$source_version" minor)

echo "This will release Zaku $release_version and update Zaku to $main_version on main."
echo
if ! read -r -p "Proceed? [y/N] " confirmation; then
  echo "Could not read confirmation" >&2
  exit 1
fi
case "${confirmation,,}" in
y | yes)
  ;;
*)
  echo "Aborted"
  exit 0
  ;;
esac

gh workflow run release.yml --ref main --field "channel=$channel" --field "source_sha=$local_sha" --field "bump_year=$bump_year"
echo "Started Zaku release $release_version"
echo "Workflow: https://github.com/buildzaku/zaku/actions/workflows/release.yml"
